{
    "name": "lunchmoney-mcp-cloudflare",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "description": "Cloudflare Worker that exposes the LunchMoney MCP server (akutishevsky/lunchmoney-mcp) as a remote MCP endpoint with Google OAuth.",
    "scripts": {
        "setup": "bash setup.sh",
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "cf-typegen": "wrangler types",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@akutishevsky/lunchmoney-mcp": "github:bm1549/lunchmoney-mcp#df910c7e6fd616eb55ba57c7d1e115e0f927ed64",
        "@bm1549/remote-mcp-cloudflare": "0.3.0",
        "@modelcontextprotocol/server": "2.0.0",
        "agents": "0.20.1",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.21.2",
        "@cloudflare/workers-types": "5.20260813.1",
        "@eslint/js": "10.0.1",
        "eslint": "10.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vitest": "4.1.10",
        "wrangler": "4.119.0"
    },
    "overrides": {
        "agents": "$agents",
        "@modelcontextprotocol/server": "$@modelcontextprotocol/server"
    }
}
